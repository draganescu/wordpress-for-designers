{
    "name": "wordpress-for-designers",
    "version": "0.2.1",
    "private": true,
    "description": "An infinite canvas of real WordPress pages, templates, template parts and patterns.",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "lint": "npm run lint:js && npm run lint:css",
        "lint:js": "wp-scripts lint-js src tests tools eslint.config.cjs webpack.config.js",
        "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
        "package": "sh tools/package.sh",
        "version": "node tools/sync-version.mjs && git add wordpress-for-designers.php",
        "wp-env": "wp-env",
        "test:e2e": "WP_BASE_URL=http://localhost:8888 wp-scripts test-playwright --config tests/e2e/playwright.config.ts",
        "test:perf": "wp-scripts test-playwright --config tests/perf/playwright.config.ts",
        "perf:report": "node tools/perf-bundle.mjs > artifacts/perf/bundle.jsonl && node tools/perf-report.mjs --head artifacts/perf --budgets tests/perf/budgets.json"
    },
    "dependencies": {
        "@wordpress/admin-ui": "^3.2.0",
        "@wordpress/dataviews": "^22.1.0",
        "@wordpress/global-styles-engine": "2.2.0",
        "@wordpress/global-styles-ui": "1.22.0",
        "@wordpress/icons": "^21.0.0",
        "@wordpress/ui": "^0.27.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.0",
        "@wordpress/e2e-test-utils-playwright": "^3.3.0",
        "@wordpress/env": "^12.2.0",
        "@wordpress/scripts": "^37.2.0",
        "@wordpress/theme": "^5.0.0",
        "@wordpress/theme-build-tools": "^1.1.0"
    }
}
