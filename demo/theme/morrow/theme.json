{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1240px"
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                { "slug": "base", "name": "Oat", "color": "#F4EFE6" },
                { "slug": "contrast", "name": "Ink", "color": "#1B1714" },
                { "slug": "accent-1", "name": "Ember", "color": "#E4572E" },
                { "slug": "accent-2", "name": "Butter", "color": "#F2C14E" },
                { "slug": "accent-3", "name": "Moss", "color": "#2F4A3A" },
                { "slug": "accent-4", "name": "Crema", "color": "#E7DDCB" },
                { "slug": "accent-5", "name": "Cobalt", "color": "#2743C4" }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "units": [ "px", "em", "rem", "vh", "vw", "%" ],
            "spacingSizes": [
                { "slug": "20", "name": "Tiny", "size": "0.5rem" },
                { "slug": "30", "name": "Small", "size": "1rem" },
                { "slug": "40", "name": "Regular", "size": "1.5rem" },
                { "slug": "50", "name": "Medium", "size": "clamp(2rem, 3vw, 2.5rem)" },
                { "slug": "60", "name": "Large", "size": "clamp(2.5rem, 5vw, 4rem)" },
                { "slug": "70", "name": "Huge", "size": "clamp(3.5rem, 8vw, 6.5rem)" },
                { "slug": "80", "name": "Vast", "size": "clamp(5rem, 12vw, 10rem)" }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "writingMode": true,
            "fontSizes": [
                { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
                { "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
                { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.375rem" } },
                { "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
                { "slug": "xx-large", "name": "Huge", "size": "4.5rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } },
                { "slug": "display", "name": "Display", "size": "8.5rem", "fluid": { "min": "3.25rem", "max": "8.5rem" } }
            ],
            "fontFamilies": [
                {
                    "slug": "manrope",
                    "name": "Manrope",
                    "fontFamily": "Manrope, sans-serif",
                    "fontFace": [
                        { "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "src": [ "file:./assets/fonts/Manrope-VariableFont_wght.woff2" ] }
                    ]
                },
                {
                    "slug": "platypi",
                    "name": "Platypi",
                    "fontFamily": "Platypi, serif",
                    "fontFace": [
                        { "fontFamily": "Platypi", "fontStyle": "normal", "fontWeight": "300 800", "src": [ "file:./assets/fonts/Platypi-VariableFont_wght.woff2" ] },
                        { "fontFamily": "Platypi", "fontStyle": "italic", "fontWeight": "300 800", "src": [ "file:./assets/fonts/Platypi-Italic-VariableFont_wght.woff2" ] }
                    ]
                },
                {
                    "slug": "ysabeau-office",
                    "name": "Ysabeau Office",
                    "fontFamily": "\"Ysabeau Office\", sans-serif",
                    "fontFace": [
                        { "fontFamily": "\"Ysabeau Office\"", "fontStyle": "normal", "fontWeight": "100 900", "src": [ "file:./assets/fonts/YsabeauOffice-VariableFont_wght.woff2" ] }
                    ]
                },
                {
                    "slug": "fira-code",
                    "name": "Fira Code",
                    "fontFamily": "\"Fira Code\", monospace",
                    "fontFace": [
                        { "fontFamily": "\"Fira Code\"", "fontStyle": "normal", "fontWeight": "300 700", "src": [ "file:./assets/fonts/FiraCode-VariableFont_wght.woff2" ] }
                    ]
                }
            ]
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                { "slug": "lift", "name": "Lift", "shadow": "0 30px 60px -30px rgba(27, 23, 20, 0.35)" }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
        },
        "spacing": {
            "blockGap": "1.5rem",
            "padding": {
                "left": "var:preset|spacing|50",
                "right": "var:preset|spacing|50"
            }
        },
        "typography": {
            "fontFamily": "var:preset|font-family|manrope",
            "fontSize": "var:preset|font-size|medium",
            "fontWeight": "450",
            "lineHeight": "1.6"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|manrope",
                    "fontWeight": "800",
                    "letterSpacing": "-0.04em",
                    "lineHeight": "1"
                }
            },
            "h1": { "typography": { "fontSize": "var:preset|font-size|display", "lineHeight": "0.92" } },
            "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
            "h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.05" } },
            "h4": { "typography": { "fontSize": "var:preset|font-size|large", "letterSpacing": "-0.02em", "lineHeight": "1.2" } },
            "h5": { "typography": { "fontSize": "var:preset|font-size|medium", "letterSpacing": "-0.01em", "lineHeight": "1.3" } },
            "h6": {
                "typography": {
                    "fontFamily": "var:preset|font-family|fira-code",
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "500",
                    "letterSpacing": "0.16em",
                    "lineHeight": "1.4",
                    "textTransform": "uppercase"
                }
            },
            "link": {
                "color": { "text": "currentColor" },
                "typography": { "textDecoration": "underline" },
                ":hover": { "typography": { "textDecoration": "none" } }
            },
            "button": {
                "color": {
                    "background": "var:preset|color|contrast",
                    "text": "var:preset|color|base"
                },
                "border": { "radius": "999px" },
                "spacing": {
                    "padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "fontWeight": "700",
                    "letterSpacing": "-0.01em"
                },
                ":hover": {
                    "color": { "background": "var:preset|color|accent-1", "text": "var:preset|color|base" }
                }
            },
            "caption": {
                "typography": {
                    "fontFamily": "var:preset|font-family|fira-code",
                    "fontSize": "var:preset|font-size|small"
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": { "fontSize": "1.5rem", "fontWeight": "800", "letterSpacing": "-0.05em" },
                "elements": { "link": { "typography": { "textDecoration": "none" } } }
            },
            "core/navigation": {
                "typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "600" },
                "elements": { "link": { "typography": { "textDecoration": "none" } } }
            },
            "core/post-title": {
                "elements": { "link": { "typography": { "textDecoration": "none" } } }
            },
            "core/post-terms": {
                "typography": {
                    "fontFamily": "var:preset|font-family|fira-code",
                    "fontSize": "var:preset|font-size|small",
                    "letterSpacing": "0.12em",
                    "textTransform": "uppercase"
                },
                "elements": { "link": { "typography": { "textDecoration": "none" } } }
            },
            "core/post-date": {
                "typography": {
                    "fontFamily": "var:preset|font-family|fira-code",
                    "fontSize": "var:preset|font-size|small",
                    "letterSpacing": "0.12em",
                    "textTransform": "uppercase"
                }
            },
            "core/post-featured-image": {
                "border": { "radius": "20px" }
            },
            "core/image": {
                "border": { "radius": "20px" }
            },
            "core/cover": {
                "border": { "radius": "28px" }
            },
            "core/quote": {
                "border": { "left": { "width": "0px", "style": "none" } },
                "spacing": { "padding": { "left": "0" } },
                "typography": {
                    "fontSize": "var:preset|font-size|x-large",
                    "fontWeight": "700",
                    "letterSpacing": "-0.03em",
                    "lineHeight": "1.1"
                }
            },
            "core/separator": {
                "color": { "text": "var:preset|color|contrast" },
                "border": { "width": "0 0 2px 0" }
            },
            "core/details": {
                "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "700", "letterSpacing": "-0.02em" }
            }
        }
    },
    "customTemplates": [
        { "name": "page-no-title", "title": "Page, no title", "postTypes": [ "page" ] }
    ],
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ]
}
